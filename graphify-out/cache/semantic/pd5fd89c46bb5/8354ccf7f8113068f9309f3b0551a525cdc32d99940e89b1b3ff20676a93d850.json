{"nodes": [{"id": "docs_backup_restore_doc", "label": "Backup & Restore Documentation", "file_type": "document", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_settings_screen", "label": "BackupSettingsScreen", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_view_model", "label": "BackupViewModel", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_repository_impl", "label": "BackupRepositoryImpl", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_collector", "label": "BackupCollector", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_validator", "label": "BackupValidator", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_serializer", "label": "BackupSerializer", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_crypto", "label": "BackupCrypto", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_restorer", "label": "BackupRestorer", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_safety_backup_store", "label": "SafetyBackupStore", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_cloud_backup_api", "label": "CloudBackupApi", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_dao", "label": "BackupDao", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_app_database", "label": "AppDatabase (Room/SQLCipher)", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_nccb_format", "label": "NCCB Backup File Format (.nccb)", "file_type": "concept", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_portable_encryption", "label": "Portable Backup Encryption (AES-256-GCM / PBKDF2)", "file_type": "rationale", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Portable backups need password-based encryption independent of the device-bound database key because a backup must be restorable on a different device/install; the password is never stored for manual exports, and there is deliberately no server-side escrow \u2014 a lost password means the backup cannot be recovered."}, {"id": "docs_backup_restore_local_db_encryption", "label": "Local SQLCipher Database Encryption", "file_type": "rationale", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local database at rest uses SQLCipher with a key from Android Keystore-backed EncryptedSharedPreferences \u2014 device-bound and never leaving the device, which is why it cannot be reused for portable backups."}, {"id": "docs_backup_restore_merge_strategy", "label": "Merge Rule: Last-Write-Wins + Insert-If-Absent", "file_type": "rationale", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merge reuses the exact last-write-wins rule SyncRepositoryImpl already applies against Supabase rather than inventing a second conflict rule; append-only ledgers with no reliable timestamp get insert-if-absent only so existing rows are never overwritten."}, {"id": "docs_backup_restore_hard_delete_resurrection", "label": "Merge Hard-Delete Resurrection Limitation", "file_type": "rationale", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard DELETE leaves no tombstone, so a merge from an older backup cannot tell 'never existed' from 'deleted since' and re-inserts deleted rows; a deleted_records tombstone table would close the gap \u2014 explicitly called out as out of scope rather than silently assumed away."}, {"id": "docs_backup_restore_resync_integration", "label": "Restore Resync via Existing Sync Pipeline", "file_type": "rationale", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every restored row with isSynced=false is re-enqueued onto the existing sync_queue and SyncManager.scheduleImmediateSync is called once, so restore reuses the normal upsert-by-id path and can never create a duplicate Supabase row; restore never talks to Supabase directly."}, {"id": "docs_backup_restore_sync_repository_impl", "label": "SyncRepositoryImpl", "file_type": "code", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backup_restore_backup_versioning", "label": "Backup Versioning / BackupMigrator", "file_type": "rationale", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "backupVersion is checked on read so a newer backup fails fast before anything is touched; because Json ignoreUnknownKeys plus field defaults are already used, most additive changes need no version bump, and BackupMigrator is the extension point for a future 1-to-2 mapping."}, {"id": "docs_backup_restore_per_account_isolation", "label": "Per-Account Backup Isolation", "file_type": "rationale", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The account id is derived from the verified JWT sub claim and checked against the D1 row's stored account_id \u2014 never from anything the client supplied in the URL or body \u2014 which is what stops one clinic from reading another clinic's backup by changing an id."}, {"id": "docs_backup_restore_no_r2_access_key", "label": "Native R2 Binding (No Access Keys)", "file_type": "rationale", "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Worker uses a native R2 binding instead of the S3-compatible API so no R2 access key or secret exists anywhere in the project \u2014 not in the Android app (the hard requirement) and not even as a Worker secret, since a binding needs none."}], "edges": [{"source": "docs_backup_restore_cloud_backup_api", "target": "cloudflare_backup_worker_readme_worker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "cloudflare_backup_worker_readme_r2_bucket", "target": "docs_backup_restore_nccb_format", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_backup_settings_screen", "target": "docs_backup_restore_backup_view_model", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_backup_view_model", "target": "docs_backup_restore_backup_repository_impl", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_backup_repository_impl", "target": "docs_backup_restore_backup_collector", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_backup_repository_impl", "target": "docs_backup_restore_backup_restorer", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_backup_repository_impl", "target": "docs_backup_restore_cloud_backup_api", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_backup_repository_imp