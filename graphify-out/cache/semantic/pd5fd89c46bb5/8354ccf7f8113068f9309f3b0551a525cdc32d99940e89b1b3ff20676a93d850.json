 "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_resync_integration", "target": "readme_offline_first_architecture", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_merge_strategy", "target": "docs_backup_restore_sync_repository_impl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_resync_integration", "target": "docs_backup_restore_sync_repository_impl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_backup_versioning", "target": "docs_backup_restore_nccb_format", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_per_account_isolation", "target": "cloudflare_backup_worker_readme_jwt_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}, {"source": "docs_backup_restore_backup_repository_impl", "target": "readme_layered_architecture", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/BACKUP_RESTORE.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "backup_restore_flow", "label": "Backup/Restore Data Flow", "nodes": ["docs_backup_restore_backup_settings_screen", "docs_backup_restore_backup_view_model", "docs_backup_restore_backup_repository_impl", "docs_backup_restore_backup_collector", "docs_backup_restore_backup_restorer", "docs_back