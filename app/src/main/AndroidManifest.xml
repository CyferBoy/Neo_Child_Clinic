<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="com.google.android.gms.auth.api.signin.SERVICE" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.integrity.service.BIND" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.common.api.BIND_SERVICE" />
        </intent>
        <intent>
            <action android:name="com.google.android.c2dm.intent.RECEIVE" />
        </intent>
    </queries>

    <application
        android:name=".app.NeoChildApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeoChild">

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NeoChild"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="neochild" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".features.widget.VaccineWidgetConfigurationActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".features.widget.VaccineWidgetReceiver"
            android:exported="true"
            android:label="Vaccine Schedule">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vaccine_widget_info" />
        </receiver>

        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.update.AppUpdateInstallReceiver"
            android:exported="false" />

        <!-- Without this, Android never routes FCM messages/token-refresh events
             to NeoChildFirebaseMessagingService: push-triggered update alerts
             (notify-update) never arrive, and a rotated FCM token never gets
             re-registered until the user happens to log out and back in. -->
        <service
            android:name=".notification.NeoChildFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>