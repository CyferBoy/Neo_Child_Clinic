{
  "name": "neochildclinic-backup-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker mediating Neo Child Clinic's cloud backup/restore against R2 (see docs/BACKUP_RESTORE.md).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute neochildclinic-backups --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute neochildclinic-backups --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241004.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.80.0"
  }
}
